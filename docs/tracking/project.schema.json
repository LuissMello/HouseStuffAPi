{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "updatedAt", "status", "currentStageId", "stages", "tasks"],
  "properties": {
    "project": { "const": "HouseStuff" },
    "updatedAt": { "type": "string", "format": "date" },
    "status": { "enum": ["onTrack", "atRisk", "blocked", "completed"] },
    "currentStageId": { "type": "string", "pattern": "^M[0-9]+$" },
    "stages": { "type": "array", "minItems": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stageId", "area", "repository", "type", "title", "status", "result", "subtasks"],
        "properties": {
          "id": { "type": "string", "pattern": "^HOUSE-[0-9]{3}$" },
          "repository": { "enum": ["api", "front", "both"] },
          "type": { "enum": ["technical", "feature"] },
          "status": { "enum": ["pending", "inProgress", "blocked", "completed"] }
        }
      }
    }
  }
}
